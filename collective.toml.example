# Copy to collective.toml (git-ignored) and edit. Credentials do NOT go here:
# they come from the environment or ~/.massive.env.

[massive_subspace_stream]
# plan = "advanced"                  # your Massive Stocks plan: starter | developer | advanced
                                     # (history limit, delayed or real-time stream, datasets)
# data_root = "~/market_data/massive"
# env_file = "~/.massive.env"
# backfill_since = "2003-09-10"      # earliest flat file
# download_workers = 4               # Massive throttles above ~4-8 parallel downloads
# tick_workers = 1                   # trades/quotes files are 3-9 GB each
# keep_raw = false                   # keep downloaded .csv.gz after conversion

# Live stream: channels for ALL tickers, plus heavier channels for a watchlist only.
# stream_channels = ["AM", "A"]      # AM = minute bars, A = second bars
# stream_watchlist = ["SPY", "QQQ", "AAPL"]
# stream_watchlist_channels = ["T", "Q"]   # T = trades, Q = quotes
# stream_flush_seconds = 30
# keep_live_days = 7                 # 0 keeps live data forever

# launchd daily sync time (local), Tue-Sat
# sync_hour = 6
# sync_minute = 30

[edgar_cortical_node]
# data_root = "~/market_data/edgar"
# The SEC requires a contact e-mail in the User-Agent; the default is a placeholder.
# user_agent = "your-name your@email.example"
# requests_per_second = 8          # SEC limit is 10
# bulk_refresh_days = 30           # full reload of the bulk file this often
# sync_hour = 7                    # launchd daily sync (local), Tue-Sat

[vinculum]
# data_root = "~/market_data/vinculum"
# start_year = 2003                # first year of the market-cap table
# build_hour = 7                   # launchd nightly build (local), Tue-Sat, after both syncs
# build_minute = 45
